{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2022-2026 Liviu Ionescu. All rights reserved.",
  "description": "Raspberry Pi device components",
  "cdlComponents": [
    {
      "id": "micro-os-plus.devices.raspberry-pi",
      "alias": "micro-os-plus.device",
      "display": "Raspberry Pi devices",
      "description": "The Raspberry Pi devices definitions",
      "publicIncludeFolders": [
        "include",
        // Header-only register bit-field definitions used to bring up the
        // clocks without CMSIS headers (not available for RISC-V).
      ],
      "sourceFiles": [
        "src/system-rp2xxx.cpp"
      ],
      "$comment": "Clarify how to use the device definition, known in the platform",
      "dependencies": [
        "micro-os-plus.diag.trace",
        "micro-os-plus.architecture"
        // Pico SDK, but can't represent here.
      ],
      "implementedInterfaces": [
        "micro-os-plus.device"
      ],
      "generatedFile": {
        "type": "c-header",
        "filePath": "{{buildFolderPath}}/generated/include/micro-os-plus/device-defines.h"
      },
      // "defaultDefine": "MICRO_OS_PLUS_DEVICES_RASPBERRY_PI_ENABLED",
      "cdlOptions": [
        {
          "id": "core",
          "display": "CPU core",
          "description": "Select the Raspberry Pi CPU",
          "valueType": "string",
          "legalValues": [
            "rp2040",
            "rp2350-arm",
            "rp2350-riscv"
          ],
          // "defaultDefine": "MICRO_OS_PLUS_DEVICES_RASPBERRY_PI_CORE"
          // MICRO_OS_PLUS_DEVICES_RASPBERRY_PI_CORE_RP2040
          // MICRO_OS_PLUS_DEVICES_RASPBERRY_PI_CORE_RP2350_ARM
        }
      ],
      "cdlComponents": [
        {
          "id": "micro-os-plus.devices.raspberry-pi.sdk-sbrk",
          "display": "SDK _sbrk()",
          "description": "The SDK _sbrk() implementation for the RPxxxx",
          "sourceFiles": [
            "src/_sbrk.c"
          ],
          // "defaultDefine": "MICRO_OS_PLUS_DEVICES_RASPBERRY_PI_SDK_SBRK_ENABLED"
        },
        {
          "id": "micro-os-plus.devices.raspberry-pi.system-clock",
          "display": "System clock",
          "description": "The system clock implementation for the RPxxxx",
          "sourceFiles": [
            "src/system-clock.cpp"
          ],
          // "defaultDefine": "MICRO_OS_PLUS_DEVICES_RASPBERRY_PI_SYSTEM_CLOCK_ENABLED"
        },
      ]
    },
    // These two should be mutually exclusive, depending on the selected CPU core,
    // and located inside the parent. Due to current xcdl-export limitations,
    // they are temporarily placed outside their parent.
    {
      "id": "micro-os-plus.devices.raspberry-pi.rp2040-support",
      "display": "RP2040 support",
      "description": "The RP2040 Cortex-M0+ interrupt vectors and bootstrap",
      "publicIncludeFolders": [
        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2_common/cmsis/stub/CMSIS/Core/Include",
        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2_common/cmsis/stub/CMSIS/Device/RP2040/Include",
        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2040/hardware_regs/include"
      ],
      "sourceFiles": [
        "src/rp2040/vectors-rp2040.c",
        "src/system-rp2xxx.cpp",
        "src/rp2040/bs2_default_padded_checksummed.S"
      ],
      "dependencies": [
        "micro-os-plus.device"
      ],
      // "defaultDefine": "MICRO_OS_PLUS_DEVICES_RASPBERRY_PI_RP2040_SUPPORT_ENABLED"
    },
    {
      "id": "micro-os-plus.devices.raspberry-pi.rp2350-arm-support",
      "display": "RP2350 Cortex-M33 support",
      "description": "The RP2350 Cortex-M33 core interrupt vectors and bootstrap",
      "publicIncludeFolders": [
        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2_common/cmsis/stub/CMSIS/Core/Include",
        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2_common/cmsis/stub/CMSIS/Device/RP2350/Include",
        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/common/boot_picobin_headers/include",
        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2350/hardware_regs/include"
      ],
      "sourceFiles": [
        "src/rp2350-arm/vectors-rp2350.c",
        "src/system-rp2xxx.cpp",
        "src/rp2350-arm/embedded-block-rp2350-arm.c"
      ],
      "dependencies": [
        "micro-os-plus.device"
      ],
      // "defaultDefine": "MICRO_OS_PLUS_DEVICES_RASPBERRY_PI_RP2350_ARM_SUPPORT_ENABLED"
    },
    {
      "id": "micro-os-plus.devices.raspberry-pi.rp2350-riscv-support",
      "display": "RP2350 RISC-V support",
      "description": "The RP2350 RISC-V core support and bootstrap",
      "publicDefines": [
        "NO_PICO_PLATFORM"
      ],
      "publicIncludeFolders": [
        // "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2_common/pico_bootrom/include",
        // "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2_common/boot_bootrom_headers/include",
        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2350/hardware_regs/include",
        // /"${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2350/pico_platform/include",
        // /"${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/common/boot_picobin_headers/include",

        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/common/boot_picobin_headers/include",
        // For "pico/bootrom_constants.h".
        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2_common/pico_bootrom/include",
        "${CMAKE_BINARY_DIR}/xpacks/@xpack-3rd-party/raspberrypi-pico-sdk/src/rp2_common/boot_bootrom_headers/include"

      ],
      "sourceFiles": [
        "src/rp2350-riscv/debugger-entry-point.S",
        "src/rp2350-riscv/trap-handler.cpp",
        "src/rp2350-riscv/embedded-block-rp2350-riscv.c"
      ],
      "dependencies": [
        "micro-os-plus.device"
      ],
      // "defaultDefine": "MICRO_OS_PLUS_DEVICES_RASPBERRY_PI_RP2350_RISCV_SUPPORT_ENABLED"
    },
  ]
}